#!/usr/bin/env bash
# Launch omarchy agent in a repo to review changes and create a commit.
set -euo pipefail

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a evo.github -t 5000 "${1:-GitHub}" "${2:-}"
}

dir=${1:?repo path required}
prompt="Review the git changes in this repository, stage the appropriate files, and create a commit with a concise message that follows the project's commit conventions. Do not push."

if ! command -v xdg-terminal-exec >/dev/null 2>&1; then
  notify "GitHub" "Could not start agent: xdg-terminal-exec not found"
  exit 1
fi

if ! command -v omarchy >/dev/null 2>&1; then
  notify "GitHub" "Could not start agent: omarchy not found"
  exit 1
fi

exec xdg-terminal-exec --dir="$dir" omarchy agent prompt "$prompt"
