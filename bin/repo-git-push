#!/usr/bin/env bash
# Push the current branch from a repo in a terminal.
set -euo pipefail

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a evo.github -t 5000 "${1:-GitHub}" "${2:-}"
}

dir=${1:?repo path required}

if ! command -v xdg-terminal-exec >/dev/null 2>&1; then
  notify "GitHub" "Could not push: xdg-terminal-exec not found"
  exit 1
fi

exec xdg-terminal-exec --dir="$dir" git push