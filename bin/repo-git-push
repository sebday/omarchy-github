#!/usr/bin/env bash
# Push the current branch from a repo in the background.
set -euo pipefail

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a evo.github -t "${3:-5000}" "${1:-GitHub}" "${2:-}"
}

dir=${1:?repo path required}
name="$(basename "$dir")"

if ! command -v git >/dev/null 2>&1; then
  notify "GitHub" "Could not push: git not found"
  exit 1
fi

notify "GitHub" "Pushing ${name}…"

(
  log="$(mktemp "${TMPDIR:-/tmp}/evo-github-push.XXXXXX")"
  trap 'rm -f "$log"' EXIT
  if git -C "$dir" push >"$log" 2>&1; then
    notify "GitHub" "Pushed ${name}" 8000
  else
    err="$(tail -n 3 "$log" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')"
    [[ -n "$err" ]] || err="git push failed"
    notify "GitHub" "Push failed for ${name}: ${err}" 10000
  fi
) &
