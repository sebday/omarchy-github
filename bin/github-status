#!/usr/bin/env bash
# GitHub contribution stats for evo.github Omarchy bar widget.
set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/bar"
CACHE_PATH="${CACHE_DIR}/github.json"
CACHE_TTL="${GITHUB_CACHE_TTL:-300}"
HEATMAP_DAYS=30

declare -a GITHUB_COLORS=("#45475a" "#89b4fa" "#74c7ec" "#89dceb" "#cba6f7")

json_github() {
  jq -cn \
    --arg text "$1" \
    --argjson today "$2" \
    --argjson cells "$3" \
    --arg class "$4" \
    --arg username "$5" \
    --argjson total30 "$6" \
    --argjson streak "$7" \
    --argjson best "$8" \
    --arg profileUrl "$9" \
    '{
      text: $text,
      today: $today,
      cells: $cells,
      class: $class,
      username: $username,
      total30: $total30,
      streak: $streak,
      best: $best,
      profileUrl: $profileUrl
    }'
}

json_error() {
  local text="$1"
  local tooltip="${2:-}"
  jq -cn --arg text "$text" --arg tooltip "$tooltip" '{text: $text, tooltip: $tooltip, class: "error"}'
}

cache_read() {
  [[ -f "$CACHE_PATH" ]] || return 1
  local now mtime age
  now=$(date +%s)
  mtime=$(stat -c %Y "$CACHE_PATH" 2>/dev/null || echo 0)
  age=$((now - mtime))
  (( age < CACHE_TTL )) || return 1
  cat "$CACHE_PATH"
}

cache_write() {
  mkdir -p "$CACHE_DIR"
  local tmp
  tmp="$(mktemp "${CACHE_PATH}.XXXXXX")"
  cat >"$tmp"
  mv "$tmp" "$CACHE_PATH"
}

load_token() {
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then
    return 0
  fi
  command -v pass >/dev/null 2>&1 || return 1
  local value
  value="$(pass show omarchy/github/token 2>/dev/null || true)"
  if [[ -n "$value" ]]; then
    export GITHUB_TOKEN="$value"
    return 0
  fi
  return 1
}

contribution_level() {
  local count="${1:-0}"
  if [[ "$count" -ge 30 ]]; then echo 4; return
  elif [[ "$count" -ge 18 ]]; then echo 3; return
  elif [[ "$count" -ge 10 ]]; then echo 2; return
  elif [[ "$count" -ge 1 ]]; then echo 1; return
  fi
  echo 0
}

build_heatmap_json() {
  local -a counts=("$@")
  local level color count line
  local lines=""

  for count in "${counts[@]}"; do
    level=$(contribution_level "$count")
    color="${GITHUB_COLORS[$level]}"
    line=$(jq -cn --argjson level "$level" --argjson count "$count" --arg color "$color" \
      '{level: $level, count: $count, color: $color}')
    lines+="$line"$'\n'
  done

  printf '%s' "$lines" | jq -s '.'
}

if cached=$(cache_read 2>/dev/null); then
  printf '%s\n' "$cached"
  exit 0
fi

USERNAME="${GITHUB_USERNAME:-}"

if ! load_token; then
  json_error " Token Err" "Set GITHUB_TOKEN: pass insert omarchy/github/token"
  exit 1
fi

TOKEN="${GITHUB_TOKEN:-}"

GRAPHQL_QUERY_RAW='
query GetViewerContributionCalendar {
  viewer {
    login
    contributionsCollection {
      contributionCalendar {
        weeks {
          contributionDays {
            contributionCount
            date
          }
        }
      }
    }
  }
}
'
GRAPHQL_QUERY_ESCAPED=$(echo "$GRAPHQL_QUERY_RAW" | tr '\n' ' ' | sed 's/"/\\"/g')
JSON_PAYLOAD=$(printf '{ "query": "%s" }' "$GRAPHQL_QUERY_ESCAPED")

RESPONSE=$(curl -s -L \
  -H "Authorization: bearer ${TOKEN}" \
  -H "Content-Type: application/json" \
  -X POST \
  -d "${JSON_PAYLOAD}" \
  "https://api.github.com/graphql")

if [[ -z "$RESPONSE" ]]; then
  json_error " Curl Err" "GraphQL request returned empty."
  exit 1
fi

if echo "$RESPONSE" | jq -e '.errors' > /dev/null 2>&1; then
  ERROR_MESSAGE=$(echo "$RESPONSE" | jq -r '.errors[0].message // "Unknown GraphQL error"')
  json_error " GQL Err" "GraphQL error: ${ERROR_MESSAGE}"
  exit 1
fi

declare -A contribs_by_date=()
ALL_DAYS_DATA=$(echo "$RESPONSE" | jq -r '
  .data.viewer.contributionsCollection.contributionCalendar.weeks[]?.contributionDays[]? |
  select(.date != null and .contributionCount != null) |
  "\(.date)_\(.contributionCount)"
')

USERNAME="${USERNAME:-$(echo "$RESPONSE" | jq -r '.data.viewer.login // empty')}"
if [[ -z "$USERNAME" ]]; then
  json_error " Auth Err" "GitHub token did not return a viewer login."
  exit 1
fi

LOCAL_TODAY_ISO=$(date +'%Y-%m-%d')
declare -a day_counts=()
declare -a heatmap_chars=()

if [[ -z "$ALL_DAYS_DATA" ]]; then
  TODAY_CONTRIBUTION_COUNT=0
  for ((i = 1; i <= HEATMAP_DAYS; i++)); do
    day_counts+=(0)
    heatmap_chars+=("<span foreground='${GITHUB_COLORS[0]}'>■</span>")
  done
else
  while IFS=_ read -r date_val count_val; do
    contribs_by_date["$date_val"]=$count_val
  done <<< "$ALL_DAYS_DATA"

  for ((i = HEATMAP_DAYS - 1; i >= 0; i--)); do
    DAY_ISO=$(date -d "${LOCAL_TODAY_ISO} - ${i} days" +'%Y-%m-%d')
    COUNT_FOR_DAY=${contribs_by_date["$DAY_ISO"]:-0}
    LEVEL=$(contribution_level "$COUNT_FOR_DAY")
    day_counts+=("$COUNT_FOR_DAY")
    heatmap_chars+=("<span foreground='${GITHUB_COLORS[$LEVEL]}'>■</span>")
  done

  TODAY_CONTRIBUTION_COUNT=${contribs_by_date["$LOCAL_TODAY_ISO"]:-0}
fi

TODAY_LEVEL=$(contribution_level "$TODAY_CONTRIBUTION_COUNT")
HEATMAP_JSON=$(build_heatmap_json "${day_counts[@]}")
ACTIVITY_BOXES_STRING_FOR_JSON=$(printf '%s' "${heatmap_chars[@]}")

TOTAL30=0
BEST_COUNT=0
for count in "${day_counts[@]}"; do
  TOTAL30=$((TOTAL30 + count))
  if [[ "$count" -gt "$BEST_COUNT" ]]; then
    BEST_COUNT=$count
  fi
done

STREAK=0
DAY_ISO="$LOCAL_TODAY_ISO"
for ((i = 0; i < 400; i++)); do
  COUNT_FOR_DAY=${contribs_by_date["$DAY_ISO"]:-0}
  if [[ "$COUNT_FOR_DAY" -gt 0 ]]; then
    STREAK=$((STREAK + 1))
    DAY_ISO=$(date -d "${DAY_ISO} - 1 day" +'%Y-%m-%d')
  else
    break
  fi
done

TEXT_OUTPUT="  ${TODAY_CONTRIBUTION_COUNT} ${ACTIVITY_BOXES_STRING_FOR_JSON}"
CLASS="github-level-${TODAY_LEVEL}"
PROFILE_URL="https://github.com/${USERNAME}"

output=$(json_github "$TEXT_OUTPUT" "$TODAY_CONTRIBUTION_COUNT" "$HEATMAP_JSON" "$CLASS" \
  "$USERNAME" "$TOTAL30" "$STREAK" "$BEST_COUNT" "$PROFILE_URL")
printf '%s\n' "$output" | cache_write
printf '%s\n' "$output"
